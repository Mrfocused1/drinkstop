{
  "functions": {
    "api/order.mjs": {
      "maxDuration": 10
    }
  },
  "buildCommand": "node scripts/version-static-assets.mjs && node scripts/check-media-budget.mjs",
  "headers": [
    {
      "source": "/:file((?!api/).*\\.(?:css|js|png|jpg|jpeg|webp|svg|woff|woff2))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/:file((?!api/).*\\.(?:css|js|webp))",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": "[0-9a-f]{12}"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "outputDirectory": "."
}
